# ShadowSpark V1 Environment Configuration

# Authentication (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=https://shadowspark-tech.com

# WebAuthn (Passkeys)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ShadowSpark
WEBAUTHN_ORIGIN=http://localhost:3000
# Production values:
# WEBAUTHN_RP_ID=shadowspark-tech.com
# WEBAUTHN_RP_NAME=ShadowSpark
# WEBAUTHN_ORIGIN=https://shadowspark-tech.com

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/shadowspark?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/shadowspark?schema=public

# AI & Intelligence
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GOOGLE_AI_API_KEY=AIza...
FIRECRAWL_API_KEY=fc_...
JINA_API_KEY=jina_...

# Paystack API Keys
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_WEBHOOK_SECRET=...

# Email
RESEND_API_KEY=re_...
CONTACT_INBOX=hello@shadowspark.ng

# Public contact lead forwarding
BACKEND_API_URL=
CONTACT_LEAD_SINK_PATH=/tmp/shadowspark-contact-leads.jsonl
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WhatsApp (Meta Business API)
# Graph send prefers WHATSAPP_* names, then META_* aliases. One token per request.
WHATSAPP_API_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_VERIFY_TOKEN=...
WHATSAPP_ENABLED=false

# Meta / Facebook Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# Threads (Meta Graph API)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Redis (BullMQ queues)
REDIS_URL=redis://localhost:6379

# OAuth Providers (set OAUTH_ENABLED=true to require these)
OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback URLs:
# GitHub:  http://localhost:3000/api/auth/callback/github
# Google:  http://localhost:3000/api/auth/callback/google

# Twilio SMS and Voice (never WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_BASE_URL=https://your-production-domain
TWILIO_SMS_FROM=
TWILIO_VOICE_FROM=

# Internal API Secrets
LEAD_SYNC_SECRET=...
CRON_SECRET=...

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# GCP
GOOGLE_CLOUD_PROJECT=...
CLOUD_SQL_CONNECTION_NAME=project:region:instance
VAULT_BUCKET=...

# RAG sync (optional overrides)
RAG_CRAWL_ROOT_URL=https://shadowspark-tech.com/blog
RAG_CRAWL_LIMIT=25
RAG_CHUNK_MAX_CHARS=1800
N8N_TELEMETRY_WEBHOOK_URL=
