{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/listings/expiry",
      "schedule": "0 9 * * *"
    }
  ],
  "github": {
    "silent": false,
    "autoJobCancelation": true
  },
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Frame-Options","value":"SAMEORIGIN"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}],
  "buildCommand": "pnpm build",
  "framework": "nextjs",
  "regions": ["iad1"],
  "build": {
    "env": {
      "CI": "true",
      "VERCEL_AGENT_MODE": "read-only"
    }
  }
}
